[Unit]
Description=Golden Agent Connector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/golden-agent
EnvironmentFile=-%h/.config/golden-agent/connector.env
ExecStart=/usr/bin/env node %h/golden-agent/dist/apps/connector/src/main.js service
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.data %h/.config/golden-agent
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=default.target
